chopper.left: 890
bus.top: 458
bus.left: 1310
tvs.top: 458
tvs.left: 1730
buck.top: 598
buck.left: 890
logicmux.top: 728
logicmux.left: 450
ldo.top: 878
ldo.left: 470
controller.top: 1018
